{
  "manifest_version": 3,
  "name": "DigUp for Google",
  "short_name": "DigUp",
  "description": "Search your Google Drive and Gmail by what's in them: the slide, the sheet tab, the doc section, the PDF page, the email, the moment in a video.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "135",
  "icons": { "128": "icon.png" },
  "action": { "default_popup": "popup.html", "default_title": "DigUp" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["identity", "offscreen", "storage", "unlimitedStorage", "alarms"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://docs.googleapis.com/*",
    "https://sheets.googleapis.com/*",
    "https://slides.googleapis.com/*",
    "https://gmail.googleapis.com/*",
    "https://*.googleusercontent.com/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space" },
      "description": "Search Drive and Gmail"
    }
  },
  "omnibox": { "keyword": "dig" },
  "oauth2": {
    "client_id": "925167868507-kiq8s7uee2r5v1pveegh3qjv9ke64k96.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.readonly", "https://www.googleapis.com/auth/gmail.readonly"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
